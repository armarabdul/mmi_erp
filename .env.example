# ==============================================================================
# MMI AI Analytics — Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
APP_NAME="MMI AI Analytics"
APP_VERSION=0.1.0
DEBUG=True

# Database Configuration (PostgreSQL / SQLite support)
# For local zero-friction without external DB:
DATABASE_URL=sqlite:///./mmi_analytics.db
# For production / local PostgreSQL:
# DATABASE_URL=postgresql://mmi_user:mmi_password@localhost:5432/mmi_analytics
DB_ECHO=False
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# JWT & Authentication
JWT_SECRET=mmi-super-secure-enterprise-jwt-secret-key-change-in-prod-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# AI Provider Configuration
# Supported: "openai" (mock fallback included if key not set or offline)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_REASONING_MODEL=gpt-4o

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:8000

# Server Binding
HOST=0.0.0.0
PORT=8000
